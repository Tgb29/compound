---
import type { CollectionEntry } from 'astro:content';
import { CATEGORY_META, CATEGORY_ORDER } from '../lib/categories';

interface Props {
  items: CollectionEntry<'daily'>['data']['items'];
}

const { items } = Astro.props;
const groups = CATEGORY_ORDER.map((category) => ({
  category,
  meta: CATEGORY_META[category],
  items: items.filter((i) => i.category === category),
})).filter((g) => g.items.length > 0);
---

<div class="groups">
  {
    groups.map((group) => (
      <section class="group" aria-labelledby={`cat-${group.category}`}>
        <h2 class="group-title" id={`cat-${group.category}`}>
          <span class:list={['dot', group.category]} />
          {group.meta.label}
        </h2>
        {group.items.map((item) => (
          <article class="item">
            <h3>{item.headline}</h3>
            <p class="item-summary">{item.summary}</p>
            <p class="why">
              <strong>Why it matters:</strong> {item.why}
            </p>
            <p class="meta">
              <a href={item.source.url} rel="noopener" target="_blank">
                {item.source.name} ↗
              </a>
              {item.tickers.map((t) => (
                <span class="chip">{t}</span>
              ))}
            </p>
          </article>
        ))}
      </section>
    ))
  }
</div>

<style>
  .group {
    margin-top: 36px;
  }
  .group-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--sans);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    padding-bottom: 8px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 4px;
  }
  .item {
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }
  .item:last-child {
    border-bottom: 0;
  }
  .item h3 {
    font-size: 1.3rem;
    margin-bottom: 8px;
  }
  .item-summary {
    font-family: var(--serif);
    font-size: 1.1rem;
    line-height: 1.6;
    margin-bottom: 10px;
  }
  .why {
    font-size: 0.95rem;
    background: var(--accent-soft);
    border-radius: 8px;
    padding: 10px 12px;
    margin-bottom: 10px;
  }
  .why strong {
    color: var(--accent-ink);
  }
  .meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 0.88rem;
    margin: 0;
  }
  .meta a {
    font-weight: 600;
    text-decoration: none;
  }
</style>
